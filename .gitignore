# Whitelist: ignore everything, then allow only what the website serves.
/*
!/.gitignore
!/index.html
!/README.md

!/logos/
/logos/*
!/logos/Cboe_Global_Markets_Logo.svg.png
!/logos/EY_logo_2019.svg.png
!/logos/Interbank-square.png
!/logos/PurSecLab.png
!/logos/github.png
!/logos/linkedin.png
!/logos/purdue-wordmark.png
!/logos/pursec-lock.png

!/photos/
/photos/*
!/photos/cboe-solo.jpg
!/photos/cboe-team.jpg
!/photos/ey-firstday.jpg
!/photos/ey-night.jpg
!/photos/interbank-team.jpg
!/photos/marcelo-headshot.jpg
!/photos/pursec-2.jpg
!/photos/projects/
/photos/projects/*
!/photos/projects/*.jpg

!/legible/
/legible/*
!/legible/index.html
!/legible/assets/
/legible/assets/*
!/legible/assets/claude.svg
!/legible/assets/gemini.svg
!/legible/assets/openai.svg
!/legible/assets/ICONS-LICENSE
!/legible/assets/README.md
!/legible/assets/refinements.css
!/legible/assets/reviewer.js

.DS_Store
